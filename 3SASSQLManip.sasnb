[{"kind":1,"language":"markdown","value":"Phase 3: Use SAS and SQL Together for Manipulation","outputs":[]},{"kind":2,"language":"sas","value":"data work.bee_sightings_clean;\n    set work.bee_sightings;\n    stateProvince = propcase(strip(stateProvince));\n    scientificName = strip(scientificName);\n    if missing(year) then data_quality_flag = \"Missing year\";\n    else data_quality_flag = \"OK\";\nrun;\n\nproc sql;\n    create table work.bee_joined as\n    select a.*, b.commonName\n    from work.bee_sightings_clean as a\n    left join work.bee_species_lookup as b\n        on upcase(a.scientificName) = upcase(b.scientificName);\nquit;","outputs":[{"items":[{"data":"[\n\t{\n\t\t\"line\": \"373  /** LOG_START_INDICATOR **/\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"374  title;footnote;ods _all_ close;\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"375  ods graphics on;\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"376  ods html5(id=vscode) style=HTMLEncore options(bitmap_mode='inline' svg_mode='inline');\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"NOTE: Writing HTML5(VSCODE) Body file: sashtml9.htm\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"377  %let _SASPROGRAMFILE = %nrquote(%nrstr(Untitled-1.sasnb));\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"378  data work.bee_sightings_clean;\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"379      set work.bee_sightings;\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"380      stateProvince = propcase(strip(stateProvince));\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"381      scientifi